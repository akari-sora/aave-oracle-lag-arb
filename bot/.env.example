# 複製成 bot/.env 就會自動讀。全部都有預設值，不填也能跑。
# 錢包建議不要寫在這裡：執行時貼上，或在 Mac 上選擇記在鑰匙圈

# CHAINS=mainnet,arbitrum,base,optimism
# RPC_URL_MAINNET=https://ethereum-rpc.publicnode.com
# RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
# RPC_URL_BASE=https://base-rpc.publicnode.com
# RPC_URL_OPTIMISM=https://mainnet.optimism.io
# SEND_RPC_URL_MAINNET=https://rpc.flashbots.net/fast
# PRIORITY_FEE_GWEI=2

OPEN_PREMIUM_BPS=300
CONFIRM_SECONDS=15
MIN_EDGE_BPS=50
TARGET_HF=1.3
MAX_WETH_PER_TX=0
MIN_WETH_PER_TX=0.5
CLOSE_PREMIUM_BPS=30
EMERGENCY_HF=1.1
EMERGENCY_MAX_PREMIUM_BPS=1000
EXIT_MAX_PREMIUM_BPS=300
POLL_MS=3000
LOG_MS=30000

# 推播 webhook（有變化才送）
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_HEADER=Authorization: Bearer xxx

# 進階
# EMERGENCY_TARGET_HF=1.3
# MIN_POOL_WETH=5
# ACTION_FAIL_ALERT=5
# GAS_LIMIT_MULT=1.25
# MAX_FEE_BASE_MULT=2
# CLOSE_ONLY=1
# RPC_URLS_MAINNET=https://...,https://...
# AGGREGATOR=kyber
# AGG_SLIPPAGE_BPS=100
# WS_URL_MAINNET=wss://...（off 關掉）
